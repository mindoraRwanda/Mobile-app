{
  "expo": {
    "name": "Mindora",
    "slug": "Mindora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/log.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/ImgForScreen/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to take photos.",
        "NSPhotoLibraryUsageDescription": "This app uses the photo library to select photos.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to record audio.",
        "UIBackgroundModes": [
          "audio",
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/log.png",
        "backgroundColor": "#000000"
      },
      "package": "com.kevinishimwe.Mindora",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_NOTIFICATION_POLICY",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "USE_FACE",
        "USE_IRIS",
        "USE_BIOMETRIC",
        "USE_BIOMETRIC_STRONG"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/log.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "800c3b16-1e5e-41c2-94c5-d13ed21933ac"
      }
    }
  }
}
