{
  "expo": {
    "name": "Mindora",
    "slug": "Mindora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/log.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/ImgForScreen/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/log.png",
        "backgroundColor": "#000000"
      },
      "package": "com.kevinishimwe.Mindora"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/log.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "800c3b16-1e5e-41c2-94c5-d13ed21933ac"
      }
    }
  }
}
